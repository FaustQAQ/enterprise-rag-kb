# ============================================================
# 企业知识库问答系统 - 本地配置模板
# 复制为 .env 后按自己的环境修改：
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
#
# .env 已加入 .gitignore，禁止提交任何真实密钥。
# ============================================================

# ---------- 应用 ----------
APP_NAME="Enterprise RAG Knowledge Base"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# 单个上传文件的最大大小（MiB），默认 10 MB。
MAX_UPLOAD_SIZE_MB=10

# ---------- 数据库 ----------
# 本地开发默认使用 SQLite，首次运行前执行：
#   python -m scripts.init_db
# 默认会在 backend 目录生成 rag_kb.db；该文件已被 .gitignore 忽略。
# 如需 PostgreSQL，可覆盖为：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_kb
DATABASE_URL=sqlite+aiosqlite:///./rag_kb.db

# ---------- Vue 3 前端联调 ----------
# 多个来源用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 在线大模型 ----------
# 本地开发默认使用 Mock；需要真实服务时将 LLM_MOCK_ENABLED 改为 false，
# 并完整配置 provider、Key、Base URL 和模型。不要写入真实 Key 到代码或仓库。
LLM_PROVIDER=deepseek
LLM_MOCK_ENABLED=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30

# ---------- Embedding ----------
# 本地 Mock 默认关闭；仅在 development/testing 中显式设为 true 才启用。
EMBEDDING_MOCK_ENABLED=false
# 只有同时配置 provider、Key、模型和维度后，才会创建真实 HTTP 适配器。
# 留空 EMBEDDING_PROVIDER 表示尚未启用 Embedding；服务会返回明确的配置错误，
# 不会生成随机向量、全零向量或文本哈希。
# 当前支持 openai / openai_compatible / openai-compatible（OpenAI 兼容的 POST /embeddings 协议）。
# 百炼中国大陆 OpenAI 兼容端点示例；请替换为自己的 Workspace ID，不要提交真实值：
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
# 单次请求最多发送多少个文本块；服务会自动分批并保持顺序。
EMBEDDING_BATCH_SIZE=10
